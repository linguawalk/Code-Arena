      "starter_code": "program EvenOdd;\nvar n: Integer;\nbegin\n  // 여기에 코드를 작성하세요\nend.\n",
      "test_cases": [
        { "stdin": "7\n", "expected_stdout": "odd\n" },
        { "stdin": "8\n", "expected_stdout": "even\n" },
